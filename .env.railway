# Railway Environment Configuration
# This file contains template variables for Railway deployment

# Database
DATABASE_URL=postgresql://user:password@db:5432/career_ai_db
SQLALCHEMY_DATABASE_URL=postgresql://user:password@db:5432/career_ai_db

# Security
SECRET_KEY=your-secret-key-here-change-in-railway
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-railway

# API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=production

# Frontend
NEXT_PUBLIC_API_URL=https://your-railway-backend-url.railway.app
NEXT_PUBLIC_APP_URL=https://your-railway-frontend-url.railway.app

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# Email (SendGrid)
SENDGRID_API_KEY=SG.your-key-here

# Redis
REDIS_URL=redis://redis:6379

# CORS
ALLOWED_ORIGINS=["https://your-railway-url.railway.app","http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
