# Application Environment
ENVIRONMENT=development
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql://career_ai_user:career_ai_pass@localhost:5432/career_ai_db
SQLALCHEMY_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# API Keys & External Services
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4-turbo-preview
LINKEDIN_API_KEY=
INDEED_API_KEY=
GITHUB_API_KEY=

# Supabase Configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# Email Configuration
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@careeraiplatform.com
SENDGRID_FROM_NAME=Career Assistant

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# Features
ENABLE_JOB_ALERTS=true
ENABLE_RESUME_OPTIMIZATION=true
ENABLE_COVER_LETTER_GENERATION=true
ENABLE_SKILL_GAP_ANALYSIS=true

# Celery Configuration (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

