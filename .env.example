# Database Configuration
POSTGRES_USER=career_ai_user
POSTGRES_PASSWORD=career_ai_pass
POSTGRES_DB=career_ai_db

# Backend Configuration
ENVIRONMENT=development
DATABASE_URL=postgresql://career_ai_user:career_ai_pass@localhost:5432/career_ai_db
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# API Keys
OPENAI_API_KEY=sk-
LINKEDIN_API_KEY=
INDEED_API_KEY=
GITHUB_API_KEY=

# Supabase Configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# Email Configuration (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@careeraiplatform.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Career Assistant

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Features Flags
ENABLE_JOB_ALERTS=true
ENABLE_RESUME_OPTIMIZATION=true
ENABLE_COVER_LETTER_GENERATION=true

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

