{
  "name": "Career AI Platform",
  "description": "AI-powered career assistance platform with job matching, resume optimization, and interview coaching",
  "region": "us-east",
  "services": {
    "backend": {
      "builder": "dockerfile",
      "dockerfile": "Dockerfile",
      "port": 8000
    },
    "frontend": {
      "builder": "nixpacks",
      "port": 3000
    },
    "database": {
      "type": "postgres",
      "version": "15"
    }
  },
  "variables": {
    "ENVIRONMENT": "production",
    "LOG_LEVEL": "INFO",
    "DATABASE_URL": "$DATABASE_URL",
    "REDIS_URL": "$REDIS_URL",
    "NEXT_PUBLIC_API_URL": "$BACKEND_URL",
    "API_HOST": "0.0.0.0",
    "API_PORT": "8000"
  }
}
