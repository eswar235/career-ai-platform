# ============================================================================
# Career AI Platform - Production Environment Configuration
# ============================================================================
# IMPORTANT: Never commit this file with actual secrets to version control
# Use secure secret management (AWS Secrets Manager, HashiCorp Vault, etc.)
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=career_ai_prod
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@postgres:5432/career_ai_prod

# ============================================================================
# JWT & SECURITY
# ============================================================================
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720
JWT_REFRESH_EXPIRATION_DAYS=30

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DOMAIN=yourdomain.com

# ============================================================================
# API KEYS & EXTERNAL SERVICES
# ============================================================================
OPENAI_API_KEY=CHANGE_ME_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# EMAIL CONFIGURATION (SendGrid)
# ============================================================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=CHANGE_ME_YOUR_SENDGRID_API_KEY
SENDER_EMAIL=noreply@yourdomain.com
SENDER_NAME=Career AI Platform

# Backup SMTP Configuration (if not using SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME_YOUR_SENDGRID_API_KEY
SMTP_USE_TLS=True

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_ENVIRONMENT=production
NEXT_PUBLIC_APP_NAME=Career AI Platform
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
SENTRY_DSN=CHANGE_ME_YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============================================================================
# AWS CONFIGURATION (Optional - for S3, etc.)
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME_YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_YOUR_AWS_SECRET_KEY
AWS_S3_BUCKET=career-ai-prod-bucket

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
STORAGE_TYPE=local
UPLOAD_DIR=/var/lib/career-ai/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=pdf,doc,docx,txt

# ============================================================================
# SESSION & CACHE CONFIGURATION
# ============================================================================
SESSION_TIMEOUT_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# FEATURE FLAGS
# ============================================================================
FEATURE_INTERVIEW_COACH=True
FEATURE_BROWSER_AUTOMATION=True
FEATURE_NOTIFICATIONS=True
FEATURE_ANALYTICS=True
FEATURE_ADMIN_PANEL=True

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_ENABLED=True
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/var/lib/career-ai/backups

# ============================================================================
# SECURITY HEADERS
# ============================================================================
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_SSL_REDIRECT=True
SECURE_FRAME_DENY=True
SECURE_CONTENT_SECURITY_POLICY=True

# ============================================================================
# ADMIN CONFIGURATION
# ============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ============================================================================
# NOTIFICATIONS
# ============================================================================
NOTIFICATION_ENABLED=True
EMAIL_NOTIFICATIONS_ENABLED=True
IN_APP_NOTIFICATIONS_ENABLED=True
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_BATCH_INTERVAL_SECONDS=300

# ============================================================================
# ANALYTICS
# ============================================================================
ANALYTICS_ENABLED=True
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_BATCH_SIZE=1000

# ============================================================================
# JOB PROCESSING
# ============================================================================
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
CELERY_TASK_TIMEOUT=3600

# ============================================================================
# API DOCUMENTATION
# ============================================================================
OPENAPI_URL=/openapi.json
DOCS_URL=/docs
REDOC_URL=/redoc
